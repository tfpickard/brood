# American Brood Society: environment. Copy to .env for local work. Never commit .env.

# Postgres (Neon pooled connection string in production).
DATABASE_URL=postgres://brood:brood@localhost:5432/brood_dev

# The Secretariat (moderation queue) secret. At least 16 characters.
ADMIN_SECRET=
# HMAC key for rate-limit records. Defaults to ADMIN_SECRET if unset.
RATE_LIMIT_SECRET=

# Transactional mail: none | resend | mock. With none, inquiries are stored and queued only.
MAIL_PROVIDER=none
MAIL_FROM=
MAIL_TO=
RESEND_API_KEY=
# Test fixture only; refused in a production deploy.
MAIL_MOCK_FILE=

# The address printed in the correspondence policy for removal requests.
PUBLIC_CORRESPONDENCE_ADDRESS=

# Phase 2 feature flags. All off. A flag is on only when set to the exact value "on".
FLAG_MEMBERS=off
FLAG_REMARKS=off
FLAG_LISTS=off
FLAG_FOLLOWING=off

# ---------------------------------------------------------------------------------------------
# OPENAI_API_KEY: LOCAL SHELL ONLY. NEVER SET ON NETLIFY OR IN ANY DEPLOYED ENVIRONMENT.
# Used solely by the owner-run media CLI (see README). The deployed site has no code path that
# reads it. Export it in your own shell for a single run, then unset it.
# OPENAI_API_KEY=
