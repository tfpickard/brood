{
	"name": "brood",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "prettier --check . && eslint . --max-warnings 0",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:e2e": "playwright test --trace off",
		"check:voice": "node scripts/check-voice.ts",
		"db:migrate": "node scripts/migrate.ts",
		"content:studbook": "node scripts/build-studbook.ts"
	},
	"dependencies": {
		"postgres": "3.4.9"
	},
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-netlify": "6.0.4",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "6.2.4",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "22.20.5",
		"eslint": "9.39.5",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"prettier": "3.10.1",
		"prettier-plugin-svelte": "3.5.2",
		"svelte": "5.57.2",
		"svelte-check": "4.7.8",
		"tailwindcss": "4.3.3",
		"typescript": "5.9.3",
		"typescript-eslint": "8.72.2",
		"vite": "7.3.8",
		"vitest": "4.1.12",
		"yaml": "2.9.1"
	}
}
